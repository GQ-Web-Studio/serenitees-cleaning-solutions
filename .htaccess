# Production media types, compression, caching, and conservative security headers.
AddType model/gltf-binary .glb
AddType video/mp4 .mp4

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|ico|mp4|glb)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -MultiViews
RewriteEngine On

# Redirect legacy public HTML paths to their clean canonical URLs.
# THE_REQUEST prevents these rules from firing after an internal rewrite.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ https://sereniteescleaning.ca/ [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(?:html/)?(about|residential-cleaning|commercial-cleaning|contact|request-a-quote|privacy-policy)\.html(?:[\s?]) [NC]
RewriteRule ^(?:html/)?(about|residential-cleaning|commercial-cleaning|contact|request-a-quote|privacy-policy)\.html$ https://sereniteescleaning.ca/$1 [R=301,L,NE]

# Accept an accidental trailing slash but keep the public URL extensionless.
RewriteRule ^(about|residential-cleaning|commercial-cleaning|contact|request-a-quote|privacy-policy)/$ https://sereniteescleaning.ca/$1 [R=301,L,NE]

# Use one secure, non-www hostname for every public URL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^sereniteescleaning\.ca$ [NC]
RewriteRule ^ https://sereniteescleaning.ca%{REQUEST_URI} [R=301,L,NE]

# Serve the existing static HTML files behind the clean public URLs.
RewriteRule ^(about|residential-cleaning|commercial-cleaning|contact|request-a-quote|privacy-policy)$ html/$1.html [L]

ErrorDocument 404 /404.html
